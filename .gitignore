# ── Dépendances ──────────────────────────────
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# ── Secrets / environnement ──────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Builds ───────────────────────────────────
dist/
build/
.vite/
*.egg-info/

# ── Tests / couverture / caches d'outils ─────
coverage/
.nyc_output/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.eslintcache
htmlcov/

# ── Logs ─────────────────────────────────────
logs/
*.log
npm-debug.log*
*.pid

# ── Données métier réelles (jamais versionnées) ──
backend/data/*
!backend/data/.gitkeep
*.xlsx
*.xls
*.csv

# ── Artefacts IA (modèles entraînés) ─────────
ai-service/app/models/*
!ai-service/app/models/.gitkeep
*.pkl
*.joblib

# ── Éditeurs / OS ────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ── Outils IA locaux ─────────────────────────
.claude/settings.local.json
.claude/skills/
