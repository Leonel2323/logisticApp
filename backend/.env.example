NODE_ENV=development
PORT=5000

# Supabase PostgreSQL : Project Settings → Database → Connection string.
# Encoder les caractères spéciaux du mot de passe (@ → %40, # → %23...).
DATABASE_URL=postgresql://postgres.<ref-projet>:<mot-de-passe>@<region>.pooler.supabase.com:6543/postgres

# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Compte admin créé par le seed 00_users (obligatoire pour npm run seed, 12 caractères min.)
ADMIN_EMAIL=admin@sobro.cm
ADMIN_PASSWORD=

# URL du service IA (ai-service)
AI_SERVICE_URL=http://localhost:8000
